# From https://developer.whoop.com dashboard -> your app
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the app
WHOOP_REDIRECT_URI=http://localhost:8787/callback
# Where OAuth tokens are persisted (default: ~/.whoop-mcp/tokens.json)
# WHOOP_TOKEN_PATH=
# Set to 1 to print the login URL instead of opening a browser (headless / SSH)
# WHOOP_NO_BROWSER=1
